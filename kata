#!/bin/bash
evaporator () {
    local content=$1
    local rate=$2
    local threshold=$3

    local day=0
    local remaining=100

    while (( $(echo "$remaining > $threshold" | bc -l) )); do
        remaining=$(echo "$remaining * (1 - $rate / 100)" | bc -l)
        day=$((day + 1))
    done

    echo $day
}
evaporator "$1" "$2" "$3"
