# return a string (see: RUN SAMPLE TESTS)
#!/bin/bash
sqInRect() {
    local long=$1
    local wide=$2
    local units=0
    local sizes=()

    if [ $long -eq $wide ]; then
        echo "nil"
        return
    fi

    while [ $wide -ne 0 ]; do
        units=$(( long / wide ))
        long=$(( long % wide ))

        for (( i=0; i<units; i++ )); do
            sizes+=($wide)
        done

        local aux=$long
        long=$wide
        wide=$aux
        unset aux
    done

    IFS=' '
    echo "${sizes[*]}"
}
sqInRect $1 $2
