#!/bin/bash
evaporator () {
    local content=$1
    local rate=$2
    local threshold=$3

    # Use logarithmic formula instead of iteration
    # remaining = 100 * (1 - rate/100)^day
    # threshold = 100 * (1 - rate/100)^day
    # log(threshold/100) = day * log(1 - rate/100)
    # day = log(threshold/100) / log(1 - rate/100)

    local day=$(echo "l($threshold/100) / l(1 - $rate/100)" | bc -l)
    day=$(echo "scale=0; ($day + 0.999999999)/1" | bc)

    echo $day
}
evaporator "$1" "$2" "$3"
