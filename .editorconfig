# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
end_of_line = lf
insert_final_newline = true

[*.{cpp,cc,h,hpp}]
charset = utf-8
indent_style = space
indent_size = 4

[*.{bazel,bzl}]
indent_style = tab
indent_size = 4

[{BUILD,WORKSPACE,MODULE}]
indent_style = tab
indent_size = 4
